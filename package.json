{
  "name": "devpulse-monitor",
  "displayName": "DevPulse Monitor - CPU RAM GPU Docker & Kubernetes Monitor",
  "description": "Real-time GPU, CPU, RAM monitoring with Docker container and Kubernetes pod resource tracking for VS Code",
  "icon": "images/icon.png",
  "version": "1.19.0",
  "publisher": "ANISOFT",
  "license": "SEE LICENSE IN LICENSE",
  "sponsor": {
    "url": "https://github.com/sponsors/yusufani"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yusufani/devpulse-monitor"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "gpu",
    "docker",
    "kubernetes",
    "k8s",
    "k3s",
    "pod",
    "kubectl",
    "monitor",
    "nvidia",
    "amd",
    "system",
    "vram",
    "cpu",
    "ram",
    "devpulse",
    "process",
    "container",
    "orchestration",
    "resource"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "DevPulse",
      "properties": {
        "dockerMonitor.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "Refresh interval in seconds for sidebar monitoring"
        },
        "dockerMonitor.webviewRefreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "Refresh interval in seconds for webview panel"
        },
        "dockerMonitor.gpuMonitoring": {
          "type": "boolean",
          "default": true,
          "description": "Enable GPU monitoring"
        },
        "dockerMonitor.dockerBinary": {
          "type": "string",
          "default": "",
          "description": "Custom path to docker binary (auto-detected if empty)"
        },
        "dockerMonitor.kubectlBinary": {
          "type": "string",
          "default": "",
          "description": "Custom path to kubectl binary (auto-detected if empty)"
        },
        "dockerMonitor.hostProcHelperImage": {
          "type": "string",
          "default": "",
          "description": "When DevPulse runs INSIDE a container, host process/owner attribution for GPU processes is recovered by launching a short-lived helper container (via the mounted docker.sock) that reads the host's /proc. This sets the image to use (must already exist locally; needs a busybox/POSIX sh). Empty = auto-pick a local alpine/busybox image. Leave empty unless auto-pick fails."
        },
        "dockerMonitor.kubernetes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Monitor Kubernetes pods alongside Docker containers (auto-disabled if kubectl is missing or the cluster is unreachable)"
        },
        "dockerMonitor.kubernetes.scope": {
          "type": "string",
          "enum": [
            "node",
            "cluster"
          ],
          "default": "node",
          "description": "Which pods to show: 'node' = only pods with a container running on this machine (enables GPU/process attribution); 'cluster' = all pods in the cluster (informational)"
        },
        "dockerMonitor.kubernetes.namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Only show pods from these namespaces (empty = all namespaces)"
        },
        "dockerMonitor.kubernetes.showWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Explain in the sidebar why Kubernetes pods are not showing up (missing kubectl, unreachable cluster, over-tight scope). Only ever shown on machines that have kubectl, a kubeconfig or an in-cluster token — Docker-only setups never see it."
        },
        "dockerMonitor.notifyOnlyMyContainers": {
          "type": "boolean",
          "default": true,
          "description": "Only show container stop notifications for containers owned by the current OS user"
        },
        "dockerMonitor.enableNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Enable automatic notifications (GPU VRAM alerts, container stop, idle GPU, memory leak warnings)"
        },
        "dockerMonitor.vramAlertThreshold": {
          "type": "number",
          "default": 95,
          "minimum": 50,
          "maximum": 99,
          "description": "VRAM usage % that triggers a critical alert (default: 95)"
        },
        "dockerMonitor.idleGpuDetection": {
          "type": "boolean",
          "default": false,
          "description": "Enable idle GPU detection alerts (VRAM allocated but 0% utilization)"
        },
        "dockerMonitor.leakDetection": {
          "type": "boolean",
          "default": true,
          "description": "Enable VRAM memory leak detection (monotonic growth alerts)"
        },
        "dockerMonitor.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debug logging (owner resolution, docker top, /proc fallback details)"
        },
        "dockerMonitor.cpuManager": {
          "type": "boolean",
          "default": true,
          "description": "Show the CPU Manager section in the sidebar (per-user / per-process CPU usage)"
        },
        "dockerMonitor.ramManager": {
          "type": "boolean",
          "default": true,
          "description": "Show the RAM Manager section in the sidebar (per-user / per-process RAM usage)"
        },
        "dockerMonitor.diskManager": {
          "type": "boolean",
          "default": true,
          "description": "Show the Disk Manager section in the sidebar (per-mount / per-user disk usage)"
        },
        "dockerMonitor.podManager": {
          "type": "boolean",
          "default": true,
          "description": "Show the Pod Manager section in the sidebar (Kubernetes pods grouped by namespace, with port-forward)"
        },
        "dockerMonitor.diskUsagePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/home"
          ],
          "description": "Base directories whose first-level subfolders are measured with du for the Disk Manager (e.g. ['/home', '/data']). Calculated in the background every 10 minutes; large directories may take a while on first run."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dockerMonitor",
          "title": "DevPulse",
          "icon": "images/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "dockerMonitor": [
        {
          "type": "webview",
          "id": "dockerServices",
          "name": "Container Resources"
        },
        {
          "id": "gpuMonitor",
          "name": "System Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "dockerServices.refresh",
        "title": "DevPulse: Refresh Container Resources",
        "icon": "$(refresh)"
      },
      {
        "command": "gpuMonitor.refresh",
        "title": "DevPulse: Refresh System Monitor",
        "icon": "$(refresh)"
      },
      {
        "command": "gpuMonitor.show",
        "title": "DevPulse: Open GPU Monitor",
        "icon": "$(window)"
      },
      {
        "command": "gpuMonitor.support",
        "title": "DevPulse: Support the Project ❤",
        "icon": "$(heart)"
      },
      {
        "command": "gpuMonitor.killProcess",
        "title": "DevPulse: Kill Process",
        "icon": "$(close)"
      },
      {
        "command": "gpuMonitor.killHostProcess",
        "title": "DevPulse: Kill Process",
        "icon": "$(close)"
      },
      {
        "command": "gpuMonitor.stopContainer",
        "title": "DevPulse: Stop Container",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gpuMonitor.killContainer",
        "title": "DevPulse: Force Kill Container",
        "icon": "$(trash)"
      },
      {
        "command": "gpuMonitor.restartContainer",
        "title": "DevPulse: Restart Container",
        "icon": "$(debug-restart)"
      },
      {
        "command": "gpuMonitor.showContainerLogs",
        "title": "DevPulse: Show Container Logs",
        "icon": "$(output)"
      },
      {
        "command": "gpuMonitor.execContainer",
        "title": "DevPulse: Exec into Container",
        "icon": "$(terminal)"
      },
      {
        "command": "gpuMonitor.attachContainer",
        "title": "DevPulse: Attach to Container",
        "icon": "$(plug)"
      },
      {
        "command": "gpuMonitor.describePod",
        "title": "DevPulse: Describe Pod (kubectl)",
        "icon": "$(info)"
      },
      {
        "command": "gpuMonitor.podPortForward",
        "title": "DevPulse: Port-forward Pod Port",
        "icon": "$(globe)"
      },
      {
        "command": "gpuMonitor.podYaml",
        "title": "DevPulse: View Pod YAML",
        "icon": "$(file-code)"
      },
      {
        "command": "gpuMonitor.podEdit",
        "title": "DevPulse: Edit Pod / Workload (kubectl edit)",
        "icon": "$(edit)"
      },
      {
        "command": "gpuMonitor.podEvents",
        "title": "DevPulse: Show Pod Events",
        "icon": "$(list-unordered)"
      },
      {
        "command": "gpuMonitor.scaleWorkload",
        "title": "DevPulse: Scale Workload (replicas)",
        "icon": "$(arrow-both)"
      },
      {
        "command": "gpuMonitor.copyPodName",
        "title": "DevPulse: Copy Pod namespace/name",
        "icon": "$(copy)"
      },
      {
        "command": "gpuMonitor.showTopConsumers",
        "title": "DevPulse: Show Top GPU Consumers"
      },
      {
        "command": "gpuMonitor.findContainer",
        "title": "DevPulse: Find Container"
      },
      {
        "command": "gpuMonitor.copyContainerId",
        "title": "DevPulse: Copy Container ID"
      },
      {
        "command": "gpuMonitor.copyContainerName",
        "title": "DevPulse: Copy Container Name"
      },
      {
        "command": "gpuMonitor.copyContainerImage",
        "title": "DevPulse: Copy Container Image"
      },
      {
        "command": "gpuMonitor.openPort",
        "title": "DevPulse: Open Port in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "gpuMonitor.showEnvVars",
        "title": "DevPulse: Show Environment Variables",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "gpuMonitor.showVolumes",
        "title": "DevPulse: Show Volume Mounts",
        "icon": "$(folder-library)"
      },
      {
        "command": "gpuMonitor.exportHistory",
        "title": "DevPulse: Export GPU History (CSV)"
      },
      {
        "command": "gpuMonitor.copyProcessInfo",
        "title": "Copy Process Info",
        "icon": "$(copy)"
      },
      {
        "command": "gpuMonitor.copyDetailText",
        "title": "Copy",
        "icon": "$(copy)"
      },
      {
        "command": "gpuMonitor.k8sDiagnostics",
        "title": "DevPulse: Check Kubernetes",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "gpuMonitor.hideK8sWarning",
        "title": "Hide Kubernetes Warning",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dockerServices.refresh",
          "when": "view == dockerServices",
          "group": "navigation"
        },
        {
          "command": "gpuMonitor.show",
          "when": "view == gpuMonitor",
          "group": "navigation"
        },
        {
          "command": "gpuMonitor.refresh",
          "when": "view == gpuMonitor",
          "group": "navigation"
        },
        {
          "command": "gpuMonitor.support",
          "when": "view == gpuMonitor",
          "group": "navigation@99"
        },
        {
          "command": "gpuMonitor.k8sDiagnostics",
          "when": "view == gpuMonitor"
        },
        {
          "command": "gpuMonitor.k8sDiagnostics",
          "when": "view == dockerServices"
        }
      ],
      "view/item/context": [
        {
          "command": "gpuMonitor.hideK8sWarning",
          "when": "view == gpuMonitor && viewItem == k8sWarning",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.copyProcessInfo",
          "when": "view == gpuMonitor && viewItem == gpuProcess",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.killProcess",
          "when": "view == gpuMonitor && viewItem == gpuProcess",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.copyDetailText",
          "when": "view == gpuMonitor && viewItem == gpuProcessDetail",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.killHostProcess",
          "when": "view == gpuMonitor && viewItem == ramProcess",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.killHostProcess",
          "when": "view == gpuMonitor && viewItem == cpuProcess",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.stopContainer",
          "when": "view == gpuMonitor && viewItem == gpuContainer",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.restartContainer",
          "when": "view == gpuMonitor && viewItem == gpuContainer",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.killContainer",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.showContainerLogs",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.execContainer",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.attachContainer",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.openPort",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.showEnvVars",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.showVolumes",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.copyContainerId",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.copyContainerName",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.copyContainerImage",
          "when": "view == gpuMonitor && viewItem == gpuContainer"
        },
        {
          "command": "gpuMonitor.restartContainer",
          "when": "view == gpuMonitor && viewItem == k8sPod",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.stopContainer",
          "when": "view == gpuMonitor && viewItem == k8sPod",
          "group": "inline"
        },
        {
          "command": "gpuMonitor.killContainer",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.scaleWorkload",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.showContainerLogs",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.execContainer",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.describePod",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.podYaml",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.podEdit",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.podEvents",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.copyPodName",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.showEnvVars",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.showVolumes",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.copyContainerName",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        },
        {
          "command": "gpuMonitor.copyContainerImage",
          "when": "view == gpuMonitor && viewItem == k8sPod"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gpuMonitor.show",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "gpuMonitor.findContainer",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d"
      },
      {
        "command": "gpuMonitor.showTopConsumers",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "package": "npm run compile && mkdir -p dist && npx @vscode/vsce package --no-dependencies -o dist/",
    "publish": "npx @vscode/vsce publish --no-dependencies",
    "publish:ovsx": "npx ovsx publish *.vsix",
    "precommit": "npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.2.0"
  }
}
